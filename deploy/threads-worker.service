[Unit]
Description=Threads Tools Playwright Worker
After=network.target
[Service]
Type=simple
User=THREADS_USER
WorkingDirectory=/var/www/threads-tools/worker
EnvironmentFile=/etc/threads-tools/worker.env
RuntimeDirectory=threads-tools
RuntimeDirectoryMode=0700
Environment=TMPDIR=/run/threads-tools
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/threads-tools/storage /run/threads-tools
[Install]
WantedBy=multi-user.target
